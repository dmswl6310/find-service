NEXT_PUBLIC_KAKAO_JS_API_KEY=
KAKAO_REST_API_KEY=
ODSAY_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ODsay 서버 인스턴스별 요청 스케줄러
# 운영 기본값: 동시 실행 3개, 최소 시작 간격 250ms, 최근 1초 최대 4회
TRANSIT_SERVER_MAX_CONCURRENCY=3
TRANSIT_SERVER_MIN_START_GAP_MS=250
TRANSIT_SERVER_MAX_STARTS_PER_WINDOW=4
TRANSIT_SERVER_RATE_WINDOW_MS=1000

# 문의 폼 메일 전송(Gmail SMTP 예시)
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

# 선택값: 비워두면 CONTACT_SMTP_USER를 발신자 주소로 사용합니다.
CONTACT_FROM_EMAIL=

# AI 후보 장소 추천 (서버 전용, NEXT_PUBLIC_ 붙이지 않기)
ANTHROPIC_API_KEY=
